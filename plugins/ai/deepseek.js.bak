import axios from "axios";

let handler = async (m, { conn, text, prefix, command }) => {
  if (!text) {
    return conn.sendMessage(m.chat, { 
      text: `ꕥ 𝖣𝖤𝖤𝖯𝖲𝖤𝖤𝖪 𝖱𝟣 ｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ)\n\n` +
            `      𓈒 ◌ㅤ──    *𝖬𝖮𝖣𝖮 𝖣𝖤 𝖴𝖲𝖮*\n` +
            `      • Comando :: \`#${command} <tu mensaje>\`\n\n` +
            `      𓈒 ◌ㅤ──    *𝖤𝖩𝖤𝖬𝖯𝖫𝖮*\n` +
            `      • \`#${command} ¿Qué es DeepSeek R1?\`\n` +
            `      • \`#${command} Explícame la teoría de cuerdas\`\n\n` +
            `> 𝗐⍺𝗀𝗎ɾı ⍺𝗌𝗌ı𝗌ƚ⍺𝗇ƚ ツ`
    }, { quoted: m });
  }

  await m.react("🤖");

  try {
    const encodedText = encodeURIComponent(text);
    // API DeepSeek vía izuka - mismo host que tu ejemplo chatai
    const apiUrl = `https://my.izuka-api.xyz/api/ai/deepseek?text=${encodedText}`;
    
    const { data } = await axios.get(apiUrl, {
      timeout: 30000,
      headers: { "User-Agent": "WaguriAssistant/1.0" }
    });

    // Soporta ambos formatos: {status, result:{content, model}} y {result}
    if (!data.status || !data.result?.content) {
      await m.react("❌");
      return conn.sendMessage(m.chat, { 
        text: `ꕥ 𝖤𝖱𝖱𝖮𝖱 𝖣𝖤 𝖠𝖯𝖨 ｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ)\n\nଘ៸៸᳐⦁⩊⦁៸៸᳐ଓ « No se pudo obtener una respuesta válida de DeepSeek. »` 
      }, { quoted: m });
    }

    const aiResponse = data.result.content;
    const aiModel = data.result.model || "deepseek/deepseek-r1";

    const caption = 
      `ꕥ 𝖣𝖤𝖤𝖯𝖲𝖤𝖤𝖪 𝖱𝟣 ｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ)\n\n` +
      `      𓈒 ◌ㅤ──    *𝖱𝖤𝖲𝖯𝖴𝖤𝖲𝖳𝖠*\n` +
      `> ${aiResponse}\n\n` +
      `｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ) *Modelo: ${aiModel}*`;

    await conn.sendMessage(m.chat, { text: caption }, { quoted: m });
    await m.react("✅");

  } catch (error) {
    console.error("[DeepSeek Error]:", error?.response?.data || error?.message || error);
    await m.react("☢");
    // Fallback: intenta con chatai si deepseek falla
    try {
      const encodedText = encodeURIComponent(text);
      const fallbackUrl = `https://my.izuka-api.xyz/api/ai/chatai?text=${encodedText}`;
      const { data } = await axios.get(fallbackUrl, { timeout: 15000 });
      if (data.status && data.result?.content) {
        const caption = 
          `ꕥ 𝖣𝖤𝖤𝖯𝖲𝖤𝖤𝖪 (fallback) ｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ)\n\n` +
          `      𓈒 ◌ㅤ──    *𝖱𝖤𝖲𝖯𝖴𝖤𝖲𝖳𝖠*\n` +
          `> ${data.result.content}\n\n` +
          `｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ) *Modelo: ${data.result.model || "openai/gpt-4o-mini"}*`;
        return conn.sendMessage(m.chat, { text: caption }, { quoted: m });
      }
    } catch {}
    await conn.sendMessage(m.chat, { 
      text: `ꕥ 𝖤𝖱𝖱𝖮𝖱 𝖣𝖤 𝖢𝖮𝖭𝖤𝖃𝖨Ó𝖭 ｡ﾟ+.ღ(ゝ◡ ⚈᷀᷁ღ)\n\nଘ៸៸᳐⦁⩊⦁៸៸᳐ଓ « Ocurrió un error al conectar con DeepSeek. »` 
    }, { quoted: m });
  }
};

handler.help = ['deepseek', 'ds', 'r1'];
handler.tags = ['ai', 'tools'];
handler.command = /^(deepseek|ds|r1|deep)$/i;

export default handler;
